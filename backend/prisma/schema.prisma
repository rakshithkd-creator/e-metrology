generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  password         String
  fullName         String
  organizationName String?
  phone            String
  address          String?
  state            String?
  district         String?
  role             String       // SUPER_ADMIN, LMO, GATC, BUSINESS_USER
  status           String       @default("APPROVED") // PENDING, APPROVED, SUSPENDED
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relationships
  instruments          Instrument[]
  applications         Application[]
  assignedApplications Application[]            @relation("AssignedOfficer")
  gatcApplications     Application[]            @relation("AssignedGATC")
  inspections          VerificationInspection[] @relation("OfficerInspections")
  issuedCertificates   Certificate[]            @relation("IssuedByOfficer")
  certificates         Certificate[]            @relation("IssuedToUser")
  notifications        Notification[]
  auditLogs            AuditLog[]
}

model InstrumentType {
  id                   String   @id @default(uuid())
  name                 String   @unique
  category             String   // WEIGHING, VOLUME, LENGTH, FLOW, OTHER
  standardValidityDays Int      @default(365)
  description          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Instrument {
  id                         String   @id @default(uuid())
  instrumentId               String   @unique // e.g. LM-INST-2026-000101
  type                       String   // e.g. Electronic Weighing Scale
  category                   String   // WEIGHING, VOLUME, etc.
  manufacturer               String
  model                      String
  serialNumber               String   @unique
  capacity                   String   // e.g. "150 kg", "5000 kg"
  accuracyClass              String   // Class I, Class II, Class III, Class IV
  unitOfMeasurement          String   // kg, g, mg, L, mL, m
  dateOfManufacture          DateTime?
  installationDate           DateTime?
  location                   String
  district                   String
  state                      String
  previousVerificationNumber String?
  previousVerificationDate   DateTime?
  previousValidityDate       DateTime?
  photographUrl              String?
  supportingDocsUrl          String?
  status                     String   @default("ACTIVE") // ACTIVE, PENDING_VERIFICATION, VERIFIED, EXPIRED, DECOMMISSIONED
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  ownerId                    String
  owner                      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  applications               Application[]
  certificates               Certificate[]
  inspections                VerificationInspection[]
}

model Application {
  id                   String    @id @default(uuid())
  applicationId        String    @unique // e.g. LM-APP-2026-000101
  type                 String    // NEW_VERIFICATION, RE_VERIFICATION
  status               String    @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, ASSIGNED, SCHEDULED, INSPECTION_IN_PROGRESS, VERIFIED, REJECTED, CERTIFICATE_ISSUED, EXPIRED, CANCELLED
  remarks              String?
  verificationType     String    @default("ON_SITE") // ON_SITE, LABORATORY
  scheduledDate        DateTime?
  scheduledTime        String?
  scheduledLocation    String?
  rejectionReason      String?

  submittedAt          DateTime  @default(now())
  reviewedAt           DateTime?
  assignedAt           DateTime?
  scheduledAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  instrumentId         String
  instrument           Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedOfficerId    String?
  assignedOfficer      User?      @relation("AssignedOfficer", fields: [assignedOfficerId], references: [id])

  assignedGatcId       String?
  assignedGatc         User?      @relation("AssignedGATC", fields: [assignedGatcId], references: [id])

  inspections          VerificationInspection[]
  certificate          Certificate?
}

model VerificationInspection {
  id                 String    @id @default(uuid())
  inspectionId       String    @unique // e.g. LM-INSP-2026-000101
  verificationDate   DateTime  @default(now())
  verificationType   String    @default("ON_SITE") // ON_SITE, GATC_LAB
  location           String
  gpsLatitude        Float?
  gpsLongitude       Float?
  observations       String?
  remarks            String?
  result             String    // PASS, FAIL
  failureReason      String?
  photographs        String?   // JSON stringified array of URLs
  evidenceDocuments  String?   // JSON stringified array of URLs
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  applicationId      String    @unique
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  instrumentId       String
  instrument         Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  officerId          String
  officer            User        @relation("OfficerInspections", fields: [officerId], references: [id])

  checklistItems     InspectionChecklistItem[]
  measurements       VerificationMeasurement[]
  certificate        Certificate?
}

model InspectionChecklistItem {
  id           String                 @id @default(uuid())
  itemKey      String
  title        String
  result       String                 // PASS, FAIL, NOT_APPLICABLE
  remarks      String?

  inspectionId String
  inspection   VerificationInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model VerificationMeasurement {
  id               String                 @id @default(uuid())
  testName         String                 // e.g. "Zero Load Test", "Half Capacity Test", "Max Capacity Test", "Repeatability Test"
  standardValue    Float
  observedValue    Float
  error            Float
  permissibleError Float
  unit             String
  result           String                 // PASS, FAIL

  inspectionId     String
  inspection       VerificationInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model Certificate {
  id                 String    @id @default(uuid())
  certificateNumber  String    @unique // e.g. LM-CERT-2026-000101
  qrCodeToken        String    @unique // UUID or verification hash for public URL
  verificationDate   DateTime
  validFrom          DateTime
  validUntil         DateTime
  status             String    @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED, REVOKED
  sealNumber         String?
  pdfUrl             String?
  qrCodeDataUrl      String?   // base64 SVG / PNG data URL
  revocationReason   String?
  revokedAt          DateTime?
  revokedByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  applicationId      String    @unique
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  instrumentId       String
  instrument         Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  inspectionId       String?   @unique
  inspection         VerificationInspection? @relation(fields: [inspectionId], references: [id])

  issuedToUserId     String
  issuedTo           User      @relation("IssuedToUser", fields: [issuedToUserId], references: [id])

  issuedByOfficerId  String
  issuedBy           User      @relation("IssuedByOfficer", fields: [issuedByOfficerId], references: [id])
}

model ChecklistConfig {
  id          String   @id @default(uuid())
  itemKey     String   @unique
  title       String
  description String?
  isMandatory Boolean  @default(true)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   // APPLICATION, VERIFICATION, CERTIFICATE, EXPIRY, SYSTEM
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName       String
  userRole       String
  action         String   // USER_LOGIN, INSTRUMENT_CREATED, APPLICATION_SUBMITTED, etc.
  entityType     String   // USER, INSTRUMENT, APPLICATION, INSPECTION, CERTIFICATE
  entityId       String
  previousStatus String?
  newStatus      String?
  details        String?  // JSON stringified details
  ipAddress      String?
  timestamp      DateTime @default(now())
}
